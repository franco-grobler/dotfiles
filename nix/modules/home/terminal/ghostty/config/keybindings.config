# Only bindings that differ from Ghostty's defaults live here; check with
# `ghostty +list-keybinds --default`.

# Clipboard: paste the system clipboard, not the selection
keybind = super+shift+c=copy_to_clipboard
keybind = super+shift+v=paste_from_clipboard

# Window management: close the whole window, not just the tab/split
keybind = super+w=close_window

# Send ESC+CR so TUIs (Claude Code etc.) can insert a newline
keybind = shift+enter=text:\x1b\r
