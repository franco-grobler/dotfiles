{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "opus",
  "effortLevel": "low",
  "theme": "dark",
  "permissions": {
    "allow": [
      "Bash",
      "Edit",
      "Write",
      "Read",
      "WebFetch",
      "WebSearch",
      "Bash(grep:*)"
    ],
    "deny": ["Bash(git commit:*)", "Bash(git push:*)"]
  }
}
