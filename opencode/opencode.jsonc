{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "mcp": {
    "figma-desktop": {
      "type": "remote",
      "url": "http://127.0.0.1:3845/mcp",
      "enabled": true,
    },
  },
  "permission": {
    "bash": {
      "git commit": "deny",
      "git commit *": "deny",
      "git push": "deny",
      "git push *": "deny",
    },
  },
}
